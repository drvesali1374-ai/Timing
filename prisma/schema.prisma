// پلتفرم زمان‌سنجی صنعتی — اسکیمای فاز ۱ (هسته و جداسازی پروژه‌ها)
// مرجع: docs/DATA_DICTIONARY.md · ADR-005 (نسخه‌بندی snapshot) · ADR-009 (RBAC پروژه‌محور)
// قواعد:
//  - همه شناسه‌ها UUIDv7 تولیدشده در لایه Application (shared/ids) — نه uuid خودکار.
//  - SQLite از enum پشتیبانی نمی‌کند → مقادیر محدود با zod در دامنه اعتبارسنجی می‌شوند (نقش‌ها قابل توسعه).
//  - ConfigVersion فقط الحاقی (append-only) است؛ هرگز ویرایش/حذف نمی‌شود.
//  - حذف فیزیکی پروژه وجود ندارد؛ بایگانی = تغییر status.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── هویت ───────────────────────────

model User {
  id           String   @id
  email        String   @unique
  name         String?
  passwordHash String?
  authProvider String   @default("credentials")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships           ProjectMembership[] @relation("UserMemberships")
  createdProjects       Project[]           @relation("ProjectCreator")
  createdConfigVersions ConfigVersion[]     @relation("ConfigVersionCreator")
  auditLogs             AuditLog[]          @relation("AuditUser")
}

// ─────────────────────────── پروژه‌ها ───────────────────────────

model Project {
  id     String  @id
  code   String
  title  String
  goal   String?
  location    String?
  department String?
  line        String?
  station     String?
  product     String?
  process     String?
  responsible String?
  shift       String?
  notes       String?

  status String  @default("active") // active | archived | completed (اعتبارسنجی در دامنه)
  isDemo Boolean @default(false) // پروژه نمونه آموزشی — ایزوله از داده واقعی

  // ارجاع به الگوی پروفایل لحظه ایجاد (کپی مستقل — ADR-005)
  profileTemplateId      String?
  profileSnapshotId      String?
  profileTemplateVersion String?

  createdById            String
  createdBy              User           @relation("ProjectCreator", fields: [createdById], references: [id])
  currentConfigVersionId String? @unique
  currentConfigVersion   ConfigVersion? @relation("CurrentConfigVersion", fields: [currentConfigVersionId], references: [id])

  memberships        ProjectMembership[]
  configVersions     ConfigVersion[]
  auditLogs          AuditLog[]
  parameterValues    ParameterValue[]
  calculationResults CalculationResult[]
  activities         Activity[]
  diagrams           Diagram[]
  timingSessions     TimingSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
  @@index([status])
  @@index([isDemo])
}

model ProjectMembership {
  id        String   @id
  projectId String
  userId    String
  role      String   @default("viewer") // owner | editor | recorder | viewer — منبع حقیقت: shared/contracts/acl.ts
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation("UserMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

// ─────────────────── نسخه پیکربندی (append-only) ───────────────────

model ConfigVersion {
  id        String @id
  projectId String
  semver    String // semver معتبر؛ یکتا در پروژه
  snapshotJson String // snapshot کامل پیکربندی لحظه ایجاد (JSON)
  reason    String?

  profileTemplateId      String?
  profileTemplateVersion String?

  createdBy String
  author    User @relation("ConfigVersionCreator", fields: [createdBy], references: [id])

  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  currentForProject  Project? @relation("CurrentConfigVersion")

  createdAt DateTime @default(now())

  @@unique([projectId, semver])
  @@index([projectId])
}

// ─────────────────── الگوهای پروفایل روش‌شناختی ───────────────────

model ProfileTemplate {
  id       String @id // مثل "profile.general-industrial-time-study"
  semver   String
  nameFa   String
  description String
  scopeOfUse  String

  sourceType    String // مثل "reference-method" | "common-practice"
  sourceName    String
  sourceVersion String
  sourceUrl     String?

  assumptionsJson String // آرایه JSON از فرض‌ها
  limitationsJson String // آرایه JSON از محدودیت‌ها
  licenseNote     String?
  contentJson     String // ساختار کامل محتوا (خانواده‌ها/پارامترها/زنجیره تحلیل/فرمول‌ها)

  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────── ممیزی ───────────────────────────

model AuditLog {
  id         String  @id
  userId     String?
  action     String // مثل project.created | project.archived | member.added
  entityType String
  entityId   String
  projectId  String?
  beforeJson String?
  afterJson  String?

  createdAt DateTime @default(now())

  user    User?    @relation("AuditUser", fields: [userId], references: [id])
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
  @@index([entityType, entityId])
}

// ─────────────────── فاز ۲: مقدار پارامتر (جدای از تعریف — B2/DATA_DICTIONARY §۲٫۶) ───────────────────

model ParameterValue {
  id        String @id
  projectId String

  // شناسه فنی پایدار پارامتر (stableKey در snapshot پیکربندی)
  stableKey String

  // نسخه تعریف پارامتر لحظه ثبت — مقدار به نسخه تعریف گره خورده؛ تبدیل پنهانی ممنوع
  defVersion Int

  // دامنه مقدار: project (فاز ۲) · session/cycle/observation/activity (فاز ۴+)
  scopeType String @default("project")

  // شناسه رکورد دامنه؛ برای دامنه project از رشته خالی استفاده می‌شود (یکتایی SQLite با NULL برقرار نمی‌شود)
  scopeId  String  @default("")

  // مقدار نوع‌دار + واحد: {"value": ..., "unit": ...}
  valueJson   String
  recordedBy  String
  recordedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, stableKey, scopeType, scopeId])
  @@index([projectId, scopeType])
}

// ─────────────────── فاز ۲: نتیجه محاسبه فرمول (نسخه‌دار — A7/DATA_DICTIONARY §۲٫۱۶) ───────────────────

model CalculationResult {
  id        String @id
  projectId String

  // کلید فرمول در snapshot پیکربندی (مثل TS-011 یا f.custom)
  formulaKey      String
  formulaSemver   String
  configVersionId String

  scopeType String @default("project")
  scopeId   String @default("")

  // {"value": ..., "unit": ...} — فقط وقتی valid/incomplete
  valueJson String?

  // valid | invalid | incomplete
  status     String
  errorsJson String?
  traceJson  String
  // شناسه ورودی‌های مصرف‌شده (stableKey پارامترها/فرمول‌ها)
  inputRefsJson String

  computedBy String
  computedAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, formulaKey])
  @@index([projectId, computedAt])
}

// ─────────────────── فاز ۳: نمودارهای فرایندی OPC/FPC (B6 — مدل معنایی جدا از چیدمان) ───────────────────

// هر ردیف Diagram یک سند نمودار است؛ revisions آن append-only است (نسخه‌بندی نمودار — ENGINE_CONTRACTS قید ۵)
model Diagram {
  id        String  @id
  projectId String

  kind    String // opc | fpc
  variant String  @default("current") // current | proposed — مقایسه روش فعلی/پیشنهادی (B6)
  // برای variant=proposed: نمودار «فعلی» مرجع مقایسه
  variantOfId String?

  title       String
  description String?

  // فقط FPC — موضوع مطالعه (B6): material | person | equipment
  subject String?

  // فقط FPC — واحد مسافت نمایشی (ذخیره بر حسب متر)
  distanceUnit String? @default("m")

  // draft | confirmed | archived — ویرایش، وضعیت تأییدشده را بی‌اجازه بازنویسی نمی‌کند
  status     String @default("draft")

  // شماره revision جاری (۱ مبنا)
  currentRev Int    @default(0)

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revisions  DiagramRevision[]
  variantOf  Diagram?           @relation("DiagramVariantOf", fields: [variantOfId], references: [id])
  variants   Diagram[]         @relation("DiagramVariantOf")

  @@index([projectId, status])
  @@index([projectId, kind])
}

// هر ذخیره = یک revision جدید append-only (docJson معنایی + layoutJson چیدمان + گزارش اعتبارسنجی لحظه ذخیره)
model DiagramRevision {
  id        String  @id
  diagramId String
  revNo     Int
  reason    String?

  // مدل معنایی DiagramDoc (ENGINE_CONTRACTS §۲) — اعتبارسنجی مستقل از چیدمان
  docJson     String
  // چیدمان (مختصات گره‌ها) — جدا از مدل معنایی
  layoutJson  String
  // گزارش اعتبارسنجی لحظه ذخیره (شواهد قابل بازتولید)
  validationJson String

  // پیشنهادهای دستیار اعمال‌شده در این نسخه (ردیابی — B7): [{id, version, title}]
  appliedSuggestionsJson String?

  // وضعیت چرخه ذخیره: normal | offline-synced (این revision از صف آفلاین رسیده)
  origin     String  @default("normal")
  clientOpId String? // کلید idempotent ذخیره آفلاین (ADR-006)

  createdBy String
  createdAt DateTime @default(now())

  diagram Diagram @relation(fields: [diagramId], references: [id], onDelete: Cascade)

  @@unique([diagramId, revNo])
  @@index([diagramId, createdAt])
}

model Activity {
  id        String  @id
  projectId String

  // شناسه فنی پایدار — یکتا در فضای پروژه
  stableKey   String
  name        String
  description String?

  // نوع کار (B5 — توسعه‌پذیر): operatorManual | machineAuto | waiting | transport | inspection | setupChangeover | overlap
  workType String @default("operatorManual")

  // طبقه‌بندی ارزش — فقط با تأیید صریح کاربر (nullable): valueAdded | nonValueAdded | essentialNonVA
  vaClassification String?

  // محدودیت‌های تخصیص (ایستگاه مجاز/تجهیز اختصاصی/مهارت) — JSON
  constraintsJson String?

  stationHint   String?
  skillRequired String?

  // B5 — پیش‌نیازها (تقدم/تأخر): آرایه JSON از stableKey فعالیت‌های مقدم؛ مصرف‌کننده اصلی: بالانس فاز ۶
  predecessorsJson String?

  // منبع زمان: measured | estimated | referenced
  sourceOfTime String @default("measured")

  order     Int
  archived Boolean @default(false)

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, stableKey])
  @@index([projectId, archived])
}

// ─────────────────── فاز ۴: کرنومتر و مشاهدات (B8 — ADR-004 · DATA_DICTIONARY §۲٫۱۱–۲٫۱۴) ───────────────────

// جلسه زمان‌سنجی — داده پروژه (نه پیکربندی). اسنپ‌شات عناصر برای پایداری تاریخی رکورد.
model TimingSession {
  id        String  @id
  projectId String

  // روش ثبت: continuous | snapback | laps (پیش‌فرض از پروفایل پروژه؛ قابل انتخاب هنگام ایجاد)
  method String

  // running | paused | stopped | finalized — بازتاب آخرین رویداد وضعیت (مشتق‌پذیر از رویدادها)
  status String @default("running")

  // ناظر (نام/کد ثبت‌شده هنگام ایجاد — پیش‌فرض نام کاربر)
  observer String

  // اسنپ‌شات عناصر جلسه: [{key, name, activityStableKey?, order}]
  // رکورد اندازه‌گیری باید تاریخی پایدار بماند؛ ارجاع فعالیت + نام لحظه ثبت (بدون کپی داده فعالیت)
  elementsJson String

  // حرکت میان عناصر: manual | auto (تنظیم کاربر)
  elementAdvanceMode String @default("manual")

  // تلورانس کنترل جمع چرخه TS-005 (درصد) — اسنپ‌شات از پیکربندی لحظه ایجاد (پیش‌فرض ۵)
  tolerancePct Float @default(5)

  // منبع عناصر: activities | diagram | manual (ردیابی انتخاب کاربر)
  elementSource  String  @default("activities")
  diagramRefId   String?
  diagramRefNote String?

  // پرچم‌های یکپارچگی تجمیعی (از رویدادها — ADR-004)
  integrityFlagsJson String?

  notes String?

  startedAtWall DateTime?
  endedAtWall   DateTime?

  // فراداده دستگاه ثبت‌کننده (userAgent خلاصه‌شده — بدون داده شخصی اضافی)
  deviceMetaJson String?

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  events   TimingEvent[]
  cycles   TimingCycle[]

  @@index([projectId, status])
  @@index([projectId, createdAt])
}

// رویداد کرنومتر — append-only؛ هرگز ویرایش/حذف فیزیکی نمی‌شود (ADR-004).
// اصلاح = رویداد correction با correctionOf. clientEventId idempotent → retry/کلیک تکراری دوباره‌شماری نمی‌کند.
model TimingEvent {
  id String @id // UUIDv7 سرور

  sessionId String
  session   TimingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // شناسه idempotent کاربر (UUIDv7) — یکتا در کل جدول
  clientEventId String @unique

  // ترتیب دقیق درون جلسه — اکیداً صعودی (یکتا در جلسه)
  seq Int

  // start | cycleStart | reading | element | lap | pause | resume | stop | note | correction | finalize
  type        String
  elementId   String?
  cycleNo     Int      @default(0)

  // زمان سپری‌شده فعال یکنواخت (ms) — «قرائت کرنومتر» (ADR-004)
  elapsedActiveMs Float
  // بازه از مرز قبلی (snapback/split)
  splitMs Float?

  // زمان دیواری — ممیزی/گزارش انسانی (جدا از monotonic)
  wallClock DateTime

  note               String?
  interruptionReason String?

  // فقط correction: ارجاع هدف + مقدار جدید + دلیل
  correctionOf     String?
  correctedValueMs Float?
  correctionReason String?

  // پرچم‌های یکپارچگی لحظه ثبت (JSON array)
  integrityJson String?

  // منبع دریافت: normal | offline-synced (از صف آفلاین رسیده)
  origin     String   @default("normal")
  receivedBy String
  receivedAt DateTime @default(now())

  @@unique([sessionId, seq])
  @@unique([sessionId, clientEventId])
  @@index([sessionId, seq])
  @@index([sessionId, type])
}

// چرخه مشتق‌شده — در نهایی‌سازی جلسه ذخیره می‌شود (ثبات ورودی تحلیل فاز ۵).
// پیش از نهایی‌سازی، چرخه‌ها به‌صورت زنده از رویدادها با همان هسته مشترک مشتق می‌شوند.
model TimingCycle {
  id        String @id
  sessionId String
  session   TimingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  seq Int // ۱-مبنا

  // valid | suspect | incomplete | recovered (مشتق — TS-005/پرچم‌ها)
  status String

  startedAtEventId String
  endedAtEventId   String?

  startedElapsedMs Float
  endedElapsedMs   Float?
  cycleTimeMs      Float?
  elementsSumMs    Float
  deviationPct     Float?

  // مشاهدات عناصر: [{elementKey, elementName, durationMs, readingEventId, readingMode, flags, corrected}]
  elementsJson      String
  interruptionsJson String
  flagsJson         String?

  createdAt DateTime @default(now())

  @@unique([sessionId, seq])
  @@index([sessionId, status])
}
