// ─────────────────────────────────────────────────────────────
// اسکیمای پایگاه داده ـ نرم‌افزار زمان‌سنجی صنعتی
// مطابق مدل داده پیشنهادی PRD (بخش ۶.۴)
// قواعد: شناسه‌های پایدار UUID، داده خام هرگز حذف نرم نمی‌شود،
// حذف دائمی با Cascade صریح، Audit حداقلی برای حذف (بدون کپی محتوا)
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ═══════════════ پروژه ═══════════════

model Project {
  id          String   @id @default(uuid())
  name        String
  lineName    String   @map("line_name")
  productName String   @map("product_name")
  studyDate   String?  @map("study_date") // ISO yyyy-mm-dd — تبدیل شمسی فقط در لایه نمایش
  status      String   @default("IN_PROGRESS") // DRAFT | IN_PROGRESS | FINALIZED
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  stations            Station[]
  operators           Operator[]
  activityGroups      ActivityGroup[]
  allowanceCategories AllowanceCategory[]
  ratingTables        RatingTable[]
  chartNodes          ChartNode[]
  calculationRuns     CalculationRun[]
  settings            ProjectSetting[]
  finalization        FinalizationInfo?

  @@map("projects")
}

// تنظیمات اختصاصی پروژه (کلید/مقدار + نسخه) — PRD ۶.۴
model ProjectSetting {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  key       String
  value     String
  version   Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
  @@map("project_settings")
}

// ═══════════════ ساختار تولید ═══════════════

model Station {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  name        String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activities  Activity[]

  @@index([projectId])
  @@map("stations")
}

model Activity {
  id                String   @id @default(uuid())
  stationId         String   @map("station_id")
  groupId           String?  @map("group_id")
  name              String
  description       String?
  processType       String   @default("OPERATION") @map("process_type") // OPERATION|INSPECTION|TRANSPORT|DELAY|STORAGE
  sortOrder         Int      @default(0) @map("sort_order")
  targetSampleCount Int?     @map("target_sample_count") // تعداد نمونه هدف در سطح کل فعالیت — FR-12
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  station           Station          @relation(fields: [stationId], references: [id], onDelete: Cascade)
  group             ActivityGroup?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  workElements      WorkElement[]
  sessions          StudySession[]
  allowanceOverrides ActivityAllowanceOverride[]

  @@index([stationId])
  @@map("activities")
}

model WorkElement {
  id          String   @id @default(uuid())
  activityId  String   @map("activity_id")
  name        String
  description String?
  elementType String   @default("MANUAL") @map("element_type") // MANUAL|MACHINE|WAITING|OVERLAP
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  activity       Activity           @relation(fields: [activityId], references: [id], onDelete: Cascade)
  observations   ElementObservation[]
  rating         RatingAssessment?

  @@index([activityId])
  @@map("work_elements")
}

// ═══════════════ گروه‌ها و مجازها ═══════════════

model ActivityGroup {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activities      Activity[]
  groupAllowances GroupAllowance[]

  @@index([projectId])
  @@map("activity_groups")
}

model AllowanceCategory {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  name      String
  code      String?
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  project        Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  groupAllowances        GroupAllowance[]
  activityAllowanceOverrides ActivityAllowanceOverride[]

  @@index([projectId])
  @@map("allowance_categories")
}

// مقدار گروه برای هر دسته — درصد به‌صورت اعشاری محاسباتی (۱۵٪ = 0.15) — FR-15
model GroupAllowance {
  id           String   @id @default(uuid())
  groupId      String   @map("group_id")
  categoryId   String   @map("category_id")
  percentValue Float    @map("percent_value")
  updatedAt    DateTime @updatedAt @map("updated_at")
  group        ActivityGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  category     AllowanceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([groupId, categoryId])
  @@map("group_allowances")
}

// بازنویسی مقدار دسته در سطح فعالیت — FR-04
model ActivityAllowanceOverride {
  id           String   @id @default(uuid())
  activityId   String   @map("activity_id")
  categoryId   String   @map("category_id")
  percentValue Float    @map("percent_value")
  updatedAt    DateTime @updatedAt @map("updated_at")
  activity     Activity          @relation(fields: [activityId], references: [id], onDelete: Cascade)
  category     AllowanceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([activityId, categoryId])
  @@map("activity_allowance_overrides")
}

// ═══════════════ اپراتورها و جلسات ═══════════════

model Operator {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  displayName String   @map("display_name")
  code        String?
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  project  Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sessions StudySession[]

  @@index([projectId])
  @@map("operators")
}

// جلسه: ترکیب فعالیت × اپراتور × روش اندازه‌گیری — FR-06
// روش اندازه‌گیری پس از ایجاد قابل تغییر نیست (جلسه جدید لازم است)
model StudySession {
  id           String    @id @default(uuid())
  activityId   String    @map("activity_id")
  operatorId   String    @map("operator_id")
  timingMethod String    @map("timing_method") // SNAPBACK | CONTINUOUS
  status       String    @default("OPEN") // OPEN | CLOSED
  notes        String?
  startedAt    DateTime  @default(now()) @map("started_at")
  endedAt      DateTime? @map("ended_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  activity Activity          @relation(fields: [activityId], references: [id], onDelete: Cascade)
  operator Operator          @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  cycles   CycleObservation[]

  @@index([activityId])
  @@index([operatorId])
  @@map("study_sessions")
}

// چرخه: یک ردیف جدول زمان‌سنجی — FR-07
model CycleObservation {
  id         String   @id @default(uuid())
  sessionId  String   @map("session_id")
  cycleNo    Int      @map("cycle_no")
  notes      String?
  isComplete Boolean  @default(false) @map("is_complete")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  session      StudySession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  lanes        TimelineLane[]
  observations ElementObservation[]

  @@unique([sessionId, cycleNo])
  @@map("cycle_observations")
}

// خط زمانی مستقل (اپراتور/ماشین) برای کار هم‌زمان — FR-10
model TimelineLane {
  id       String  @id @default(uuid())
  cycleId  String  @map("cycle_id")
  laneType String  @map("lane_type") // OPERATOR | MACHINE | OTHER
  label    String
  cycle    CycleObservation    @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  observations ElementObservation[]

  @@index([cycleId])
  @@map("timeline_lanes")
}

// مشاهده عنصر در چرخه — قلب سیستم — FR-08/09/10/11
// داده خام (RawDuration/CumulativeReading/Start-EndOffset) و وضعیت محاسباتی جدا هستند
model ElementObservation {
  id                String   @id @default(uuid())
  cycleId           String   @map("cycle_id")
  workElementId     String   @map("work_element_id")
  laneId            String?  @map("lane_id")
  rawDuration       Float?   @map("raw_duration") // روش برگشت به صفر: مقدار خام ثبت‌شده
  cumulativeReading Float?   @map("cumulative_reading") // روش پیوسته: قرائت تجمعی خام
  startOffset       Float?   @map("start_offset") // هم‌پوشانی: شروع نسبت به مبدأ چرخه
  endOffset         Float?   @map("end_offset") // هم‌پوشانی: پایان نسبت به مبدأ چرخه
  derivedDuration   Float?   @map("derived_duration") // مقدار تفاضلی/بازه‌ای محاسبه‌شده (قابل بازسازی)
  validityStatus    String   @default("VALID") @map("validity_status") // VALID|SUSPECT|EXCLUDED|INVALID
  isUserExcluded    Boolean  @default(false) @map("is_user_excluded")
  exclusionReason   String?  @map("exclusion_reason")
  outlierScore      Float?   @map("outlier_score")
  outlierRule       String?  @map("outlier_rule")
  updatedAt         DateTime @updatedAt @map("updated_at")
  cycle        CycleObservation @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  workElement WorkElement      @relation(fields: [workElementId], references: [id], onDelete: Cascade)
  lane        TimelineLane?    @relation(fields: [laneId], references: [id], onDelete: SetNull)

  @@index([cycleId])
  @@index([workElementId])
  @@map("element_observations")
}

// ═══════════════ وستینگهاوس ═══════════════

// جدول مرجع نسخه‌دار — FR-13 (نام، نسخه، منبع، توضیح)
model RatingTable {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  name      String
  version   Int      @default(1)
  source    String?
  notes     String?
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  grades      RatingTableGrade[]
  assessments RatingAssessment[]

  @@index([projectId])
  @@map("rating_tables")
}

// درجه‌های جدول (۴ عامل × درجه‌ها) — قابل ویرایش با ذخیره نسخه جدید
model RatingTableGrade {
  id            String  @id @default(uuid())
  ratingTableId String  @map("rating_table_id")
  factor        String // SKILL | EFFORT | CONDITIONS | CONSISTENCY
  gradeCode     String  @map("grade_code") // A1, B2, C, D, ...
  label         String // برچسب فارسی درجه
  value         Float // مقدار مثبت/منفی (+0.06 یا -0.05)
  hint          String? // توضیح/راهنمای فارسی
  sortOrder     Int     @default(0) @map("sort_order")
  ratingTable RatingTable @relation(fields: [ratingTableId], references: [id], onDelete: Cascade)

  @@unique([ratingTableId, factor, gradeCode])
  @@map("rating_table_grades")
}

// ارزیابی در سطح عنصر کاری — مشترک برای تمام مشاهدات همان عنصر — FR-13/۱۰.۲
model RatingAssessment {
  id               String   @id @default(uuid())
  workElementId    String   @unique @map("work_element_id")
  ratingTableId    String   @map("rating_table_id")
  skillGrade       String?  @map("skill_grade")
  effortGrade      String?  @map("effort_grade")
  conditionsGrade  String?  @map("conditions_grade")
  consistencyGrade String?  @map("consistency_grade")
  skillValue       Float    @default(0) @map("skill_value")
  effortValue      Float    @default(0) @map("effort_value")
  conditionsValue  Float    @default(0) @map("conditions_value")
  consistencyValue Float    @default(0) @map("consistency_value")
  totalFactor      Float    @default(1) @map("total_factor") // R = 1 + S + E + C + Cons
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  workElement WorkElement @relation(fields: [workElementId], references: [id], onDelete: Cascade)
  ratingTable RatingTable @relation(fields: [ratingTableId], references: [id], onDelete: Restrict)

  @@map("rating_assessments")
}

// ═══════════════ محاسبات، نمودار، نهایی‌سازی ═══════════════

// اجرای محاسبه به‌صورت Snapshot نسخه‌دار — FR-27
model CalculationRun {
  id               String   @id @default(uuid())
  projectId        String   @map("project_id")
  formulaVersion   String   @map("formula_version")
  settingsSnapshot String   @map("settings_snapshot") // JSON
  resultSnapshot   String?  @map("result_snapshot") // JSON
  status           String   @default("PENDING") // PENDING | DONE | STALE
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("calculation_runs")
}

// گره نمودار OPC/FPC — ActivityId Nullable برای گره دستی — FR-20
model ChartNode {
  id         String   @id @default(uuid())
  projectId  String   @map("project_id")
  chartType  String   @map("chart_type") // OPC | FPC
  nodeType   String   @default("OPERATION") @map("node_type") // OPERATION|INSPECTION|TRANSPORT|DELAY|STORAGE|MANUAL
  activityId String?  @map("activity_id")
  label      String
  positionX  Float    @default(0) @map("position_x")
  positionY  Float    @default(0) @map("position_y")
  isManual   Boolean  @default(false) @map("is_manual")
  sortOrder  Int      @default(0) @map("sort_order")
  updatedAt  DateTime @updatedAt @map("updated_at")
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, chartType])
  @@map("chart_nodes")
}

model ChartEdge {
  id           String  @id @default(uuid())
  projectId    String  @map("project_id")
  chartType    String  @map("chart_type") // OPC | FPC
  sourceNodeId String  @map("source_node_id")
  targetNodeId String  @map("target_node_id")
  sortOrder    Int     @default(0) @map("sort_order")
  // یال زنجیرهٔ توالی (سیستمی، با تغییر ترتیب بازسازی می‌شود) در برابر اتصال دستی کاربر
  isChain      Boolean @default(false) @map("is_chain")

  @@index([projectId, chartType])
  @@map("chart_edges")
}

// نهایی‌سازی مطالعه — ویرایش قفل نمی‌شود — FR-27
model FinalizationInfo {
  id          String   @id @default(uuid())
  projectId   String   @unique @map("project_id")
  reason      String? // دلیل نهایی‌سازی با کمبود نمونه — FR-12
  finalizedAt DateTime @default(now()) @map("finalized_at")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("finalization_info")
}

// ═══════════════ سراسری ═══════════════

// تاریخچه تغییرات مهم — عامل همیشه «کاربر محلی» — FR-27/۲.۳
// برای حذف: قبل/بعد ثبت نمی‌شود (Audit حداقلی) — FR-26
model AuditEvent {
  id         String   @id @default(uuid())
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  action     String // CREATE|UPDATE|DELETE|RESTORE|IMPORT|EXPORT|BACKUP|FINALIZE|DUPLICATE
  entityName String?  @map("entity_name")
  beforeJson String?  @map("before_json")
  afterJson  String?  @map("after_json")
  projectId  String?  @map("project_id")
  actor      String   @default("کاربر محلی")
  occurredAt DateTime @default(now()) @map("occurred_at")

  @@index([entityType, entityId])
  @@index([occurredAt])
  @@map("audit_events")
}

// نشانگر حذف دائمی — جلوگیری از بازگردانی ناخواسته در Restore — FR-26/۱۰.۵
model DeletionMarker {
  id         String   @id @default(uuid())
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  deletedAt  DateTime @default(now()) @map("deleted_at")

  @@unique([entityType, entityId])
  @@map("deletion_markers")
}

// تنظیمات سراسری برنامه (تقویم، ارقام، اعشار نمایش، پشتیبان‌گیری و ...)
model AppSetting {
  id    String @id
  value String

  @@map("app_settings")
}

// شناسنامه نسخه‌های پشتیبان سرور — FR-24
model BackupRecord {
  id            String   @id @default(uuid())
  fileName      String   @map("file_name")
  kind          String   @default("AUTO") // AUTO | MANUAL | PRE_RESTORE
  sizeBytes     Int      @default(0) @map("size_bytes")
  checksum      String
  schemaVersion String   @map("schema_version")
  projectCount  Int      @default(0) @map("project_count")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("backup_records")
}
